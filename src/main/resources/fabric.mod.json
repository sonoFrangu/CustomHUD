{
  "schemaVersion": 1,
  "id": "customhud",
  "version": "${version}",
  "name": "Beautiful Day Counter",
  "description": "A clean HUD showing the current day, the time and a day/night cycle bar, with game mode icons and milestone celebrations.",
  "authors": [
    "SCARABOCCHIO100"
  ],
  "contact": {
    "homepage": "https://modrinth.com/project/beautiful-day-counter",
    "sources": "https://github.com/sonoFrangu/CustomHUD"
  },
  "license": "MIT",
  "icon": "assets/customhud/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "org.frangu.customhud.client.CustomhudClient"
    ],
    "modmenu": [
      "org.frangu.customhud.client.CustomHudModMenu"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
